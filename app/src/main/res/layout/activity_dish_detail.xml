
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dish_details"
            android:textColor="#20242A"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <ImageView
            android:id="@+id/imgDetailThumbnail"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/dish_thumbnail" />

        <TextView
            android:id="@+id/txtDetailName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/dish_name"
            android:textColor="#20242A"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtDetailPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/zero_vnd"
            android:textColor="#EA580C"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtDetailCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/category_colon"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/txtDetailTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/prep_time_colon"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/txtDetailType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/type_colon"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/txtDetailAvailable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/status_colon"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/description"
            android:textStyle="bold"
            android:textSize="17sp"/>

        <TextView
            android:id="@+id/txtDetailDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/no_description"
            android:textColor="#667085"
            android:textSize="15sp"/>

        <Button
            android:id="@+id/btnDishImages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/manage_images" />

        <Button
            android:id="@+id/btnEditDish"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="32dp"
            android:text="@string/edit_dish"
            android:textAllCaps="false"
            android:backgroundTint="#EA580C"/>

        <Button
            android:id="@+id/btnDeleteDish"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:text="@string/delete_dish"
            android:textAllCaps="false"
            android:backgroundTint="#C62828"/>

        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:text="@string/back"
            android:textAllCaps="false"/>

    </LinearLayout>
</ScrollView>
