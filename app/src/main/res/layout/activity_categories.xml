<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/categories_header" android:textStyle="bold" android:textSize="22sp"/>
<Button android:id="@+id/btnAddCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/add_category"/>
<ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:id="@+id/categoryItems" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/></ScrollView>
<Button android:id="@+id/btnCategoryBack" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/back"/>
</LinearLayout>