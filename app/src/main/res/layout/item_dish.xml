<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="#FFFFFF"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp">

        <TextView
            android:id="@+id/txtDishIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="#FFF0DC"
            android:text="🍽"
            android:textSize="27sp" />

        <ImageView
            android:id="@+id/imgDishThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/dish_thumbnail"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtDishName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dish_name"
            android:textColor="#20242A"
            android:textSize="17sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtDishInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/sample_cat_time"
            android:textColor="#667085"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/txtDishPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sample_price"
            android:textColor="#EA580C"
            android:textSize="15sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="#9CA3AF"
        android:textSize="28sp"/>

</LinearLayout>
