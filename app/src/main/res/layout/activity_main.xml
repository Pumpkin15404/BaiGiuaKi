
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F7F8FA"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/food_manager_header"
        android:textColor="#EA580C"
        android:textSize="13sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/food_management"
        android:textColor="#20242A"
        android:textSize="24sp"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/manage_menu_subtitle"
        android:textColor="#667085"
        android:textSize="13sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <Button
            android:id="@+id/btnLanguage"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/language_toggle"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnSyncSettings"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/mockapi_settings"
            android:textAllCaps="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtSyncStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/not_configured"
        android:textSize="11sp"
        android:textColor="#64748B" />

    <EditText
        android:id="@+id/edtSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:hint="@string/search_dishes"
        android:inputType="text"
        android:singleLine="true"
        android:backgroundTint="#EA580C"
        android:padding="8dp"/>

    <Button android:id="@+id/btnCategories" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/manage_categories" android:textAllCaps="false" />
    <Button
        android:id="@+id/btnToggleFilters"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:text="@string/show_filters"
        android:textAllCaps="false"
        android:backgroundTint="#34495E"/>

    <LinearLayout
        android:id="@+id/layoutFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/category"
                    android:textStyle="bold"/>

                <Spinner
                    android:id="@+id/spinnerFilterCategory"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="5dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/status"
                    android:textStyle="bold"/>

                <Spinner
                    android:id="@+id/spinnerFilterStatus"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"/>

            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/price_range"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtMinPrice"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:hint="@string/min_price"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:textSize="14sp"/>

            <EditText
                android:id="@+id/edtMaxPrice"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:hint="@string/max_price"
                android:inputType="numberDecimal"
                android:singleLine="true"
                android:textSize="14sp"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sort_by"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/spinnerSort"
            android:layout_width="match_parent"
            android:layout_height="46dp"/>

        <Button
            android:id="@+id/btnResetFilters"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:text="@string/reset_filters"
            android:textAllCaps="false"
            android:backgroundTint="#64748B"/>

    </LinearLayout>

    <TextView
        android:id="@+id/txtDishCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        android:text="@string/all_dishes_zero"
        android:textColor="#20242A"
        android:textSize="17sp"
        android:textStyle="bold"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/layoutDishList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </ScrollView>

    <Button
        android:id="@+id/btnAddDish"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="@string/add_new_dish_plus"
        android:textAllCaps="false"
        android:backgroundTint="#EA580C"/>

</LinearLayout>
